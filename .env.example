# ============================================================================
# Follow Builders — Environment Variables Example
#
# This file documents all supported environment variables.
# For delivery setup: copy relevant lines to ~/.follow-builders/.env
# For fork operators: set GitHub repository secrets for the feed generator
# ============================================================================

# -- Delivery keys (regular users — only needed if using Telegram or Email) --

# Telegram bot token — create a bot via @BotFather on Telegram
# Get your token: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Resend API key — for email delivery (free tier: 100 emails/day)
# Get your key: https://resend.com → API Keys
# RESEND_API_KEY=your_resend_api_key_here

# -- Feed generator keys (fork operators only) --------------------------------
# Only needed if you fork this repo and run generate-feed.js yourself.
# Regular users fetching from the central feed do NOT need these.
# Set these as GitHub repository secrets, not in a local .env file.

# X/Twitter API Bearer Token — access to the v2 API (Basic tier or higher)
# Get your token: https://developer.twitter.com/en/portal/dashboard
# X_BEARER_TOKEN=your_x_bearer_token_here

# pod2txt API key — used to fetch podcast transcripts
# Get your key: https://pod2txt.vercel.app
# POD2TXT_API_KEY=your_pod2txt_api_key_here

# -- Optional overrides -------------------------------------------------------

# Override the Claude model used for digest remixing
# Default: claude-haiku-4-5-20251001 (fastest and most cost-effective)
# Options: claude-sonnet-4-6 (better summaries, higher cost)
# DIGEST_MODEL=claude-haiku-4-5-20251001
